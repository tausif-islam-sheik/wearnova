# Environment
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://wearnova:wearnova123@localhost:5437/wearnova?schema=public"

# JWT
JWT_SECRET=change-this-to-a-random-64-character-string-in-production
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=2h

# Encryption key for admin-stored Stripe credentials (falls back to JWT_SECRET)
SETTINGS_ENCRYPTION_KEY=change-this-to-a-random-64-character-string-in-production

# Frontend
FRONTEND_URL=http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Backups (defaults to ./backups under the backend directory)
BACKUP_DIR=./backups

# Security
BCRYPT_SALT_ROUNDS=12

# Stripe (TEST mode keys only — never use live keys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Default platform commission, percent (0-50). Overridable in admin settings.
PLATFORM_FEE_PERCENT_DEFAULT=8
# Days after shipment before escrow is auto-released to the seller if the
# buyer hasn't confirmed and hasn't disputed. Set 0 to disable auto-release.
ESCROW_AUTO_CONFIRM_DAYS=7

# Phone verification (OTP) - 'console' logs codes to the backend console (dev only).
# Set to 'twilio' or 'africastalking' in production and provide credentials below.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_FROM=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
